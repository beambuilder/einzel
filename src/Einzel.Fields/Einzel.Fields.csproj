<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Einzel.Fields</RootNamespace>
    <Description>
      DC and RF solvers, basis and sensitivity fields, and interpolants. Sits
      below Einzel.Transport: an integrator consumes fields, it does not solve
      them.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Einzel.Core\Einzel.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The unculled volume-mask loops are the reference the culled ones are checked
         against on every shipped template (CMP-1), and the templates live in Library. -->
    <InternalsVisibleTo Include="Einzel.Library.Tests" />
    <!-- The edge schedule of a staged field is tested against the constructor the builders call. -->
    <InternalsVisibleTo Include="Einzel.Fields.Tests" />
  </ItemGroup>

</Project>
