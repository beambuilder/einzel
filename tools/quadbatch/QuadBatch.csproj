<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Batch driver over Einzel's own solver, interpolant, waveform and integrator, used in-process so
    that one 3D solve serves thousands of ions. `einzel run` re-solves the field on every invocation,
    which the validation project cannot afford for scan lines of ~5000 ions with a per-ion RF phase.
    This is a fork-only tool; it retires when the library exposes solve-once / fly-many with explicit
    ion lists. It is built from the solution so that API drift shows up as a build failure here rather
    than at the first validation run.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>QuadBatch</AssemblyName>
    <IsPackable>false</IsPackable>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Einzel.Core/Einzel.Core.csproj" />
    <ProjectReference Include="../../src/Einzel.Fields/Einzel.Fields.csproj" />
    <ProjectReference Include="../../src/Einzel.Transport/Einzel.Transport.csproj" />
    <ProjectReference Include="../../src/Einzel.Io/Einzel.Io.csproj" />
    <ProjectReference Include="../../src/Einzel.Project/Einzel.Project.csproj" />
  </ItemGroup>

</Project>
